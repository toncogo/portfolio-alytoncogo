---
const links = [
  { href: "/#about", label: "About" },
  { href: "/#projects", label: "Projects" },
  { href: "/#timeline", label: "Timeline" },
  { href: "/#contact", label: "Contact" },
];
const isProjectsPage = Astro.url.pathname.startsWith("/projects");
---

<header class="site-header">
  <div class="container header-inner">
    <a class="brand" href="/" aria-label="Alyton Cogo, homepage">
      <span class="brand-mark" aria-hidden="true">&lt;ac/&gt;</span>
      <span class="brand-name">alyton<span>cogo_</span></span>
    </a>
    <button
      class="menu-toggle"
      type="button"
      aria-label="Open menu"
      aria-expanded="false"
      aria-controls="site-navigation"
      data-menu-toggle
    >
      <svg viewBox="0 0 24 24" width="18" height="18" fill="none" aria-hidden="true">
        <path d="M4 7h16M4 12h16M4 17h16" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" />
      </svg>
    </button>
    <nav class="site-nav" id="site-navigation" aria-label="Main navigation" data-site-menu>
      {links.map((link) => (
        <a
          href={link.href}
          aria-current={isProjectsPage && link.href === "/projects" ? "page" : undefined}
        >
          {link.label}
        </a>
      ))}
    </nav>
  </div>
</header>
